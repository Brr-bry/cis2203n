<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:layout_rowWeight="1"
    android:layout_columnWeight="1"
    android:layout_weight="0"
    android:background="#F1E9D4"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#0F0529"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/historyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="0dp"
            android:textAlignment="textEnd"
            android:textColor="#BABABA"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"

            android:ellipsize="none"
            android:gravity="bottom|end"

            android:maxLines="1"
            android:scrollbars="none"
            android:scrollHorizontally="true"
            android:text="@string/number0"

            android:textColor="@color/white"
            android:textSize="60sp"
            app:autoSizeTextType="none" />

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10sp"
            android:foregroundGravity="center"
            app:columnCount="4"
            app:rowCount="6">


            <Button
                android:id="@+id/delBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#9e72c3"
                android:gravity="fill"
                android:text="@string/Delete"
                android:textAlignment="center"
                android:textSize="16sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/clearBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#9e72c3"
                android:gravity="fill"
                android:text="@string/Clear"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/signBtn"
                android:layout_width="80dp"
                android:layout_height="6dp"
                android:layout_margin="5dp"
                android:backgroundTint="#9e72c3"
                android:gravity="fill"
                android:text="@string/sign"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/divideBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#4A2574"
                android:gravity="fill"
                android:text="@string/divide"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/sevenBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#7338a0"
                android:gravity="fill"
                android:text="@string/number7"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/eightBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#7338a0"
                android:gravity="center"
                android:text="@string/number8"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/nineBtn"
                android:layout_width="80dp"
                android:layout_height="6dp"
                android:layout_margin="5dp"
                android:backgroundTint="#7338a0"
                android:gravity="fill"
                android:text="@string/number9"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/multiplyBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#4A2574"
                android:gravity="fill"
                android:text="@string/multiply"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/fourBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#7338a0"
                android:gravity="fill"
                android:text="@string/number4"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/fiveBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#7338a0"
                android:gravity="fill"
                android:text="@string/number5"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/sixBtn"
                android:layout_width="80dp"
                android:layout_height="6dp"
                android:layout_margin="5dp"
                android:backgroundTint="#7338a0"
                android:gravity="fill"
                android:text="@string/number6"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/subtractBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#4A2574"
                android:gravity="fill"
                android:text="@string/minus"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/oneBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#7338a0"
                android:gravity="fill"
                android:text="@string/number1"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/twoBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#7338a0"
                android:gravity="fill"
                android:text="@string/number2"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/threeBtn"
                android:layout_width="80dp"
                android:layout_height="6dp"
                android:layout_margin="5dp"
                android:backgroundTint="#7338a0"
                android:gravity="fill"
                android:text="@string/number3"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/addBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#4A2574"
                android:gravity="fill"
                android:text="@string/plus"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/idBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#9e72c3"
                android:gravity="fill"
                android:text="@string/ID"
                android:textAlignment="center"
                android:textSize="14sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/zeroBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#7338a0"
                android:gravity="fill"
                android:text="@string/number0"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/decimalBtn"
                android:layout_width="80dp"
                android:layout_height="6dp"
                android:layout_margin="5dp"
                android:backgroundTint="#7338a0"
                android:gravity="fill"
                android:text="@string/period"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <Button
                android:id="@+id/equalBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:backgroundTint="#4A2574"
                android:gravity="fill"
                android:text="@string/Equal"
                android:textAlignment="center"
                android:textSize="30sp"
                app:cornerRadius="1000dp"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

        </androidx.gridlayout.widget.GridLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

